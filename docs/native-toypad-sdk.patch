diff --git a/include/rex/input/native_roster_bumper_keys.h b/include/rex/input/native_roster_bumper_keys.h
new file mode 100644
index 0000000000000000000000000000000000000000..50017df4443c8aa7d46faddb9c3d34ab174f9dc9
--- /dev/null
+++ b/include/rex/input/native_roster_bumper_keys.h
@@ -0,0 +1,103 @@
+#pragma once
+#include <array>
+#include <cstdint>
+#include <deque>
+#include <mutex>
+#include <rex/input/native_roster_input_latch.h>
+
+namespace rex::input {
+// Both guest polling paths must feed every Sample, in sampling order. Raw
+// VK_PAD_L/RSHOULDER events must be discarded by the integration, not forwarded.
+// Queue reset/overflow retains only balancing ups for downs ALREADY delivered.
+class NativeRosterBumperKeys {
+ public:
+  struct Event { uint16_t virtual_key; uint16_t flags; };
+  static constexpr uint16_t kDown=1, kUp=2, kRepeat=4;
+  static constexpr uint16_t kLB=0x100, kRB=0x200, kMask=kLB|kRB;
+  static constexpr uint64_t kRepeatDelayMs=400, kRepeatPeriodMs=80;
+  static constexpr size_t kCapacity=64;
+
+  void Feed(uint32_t user, const NativeRosterInputLatch::Sample& sample,
+            uint64_t now, uint64_t stamp=0) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (user>=states_.size()) return;
+    auto& s=states_[user];
+    if (s.stamp!=stamp || sample.blocked || stamp) Reset(s,stamp);
+    if (sample.blocked || stamp) return;
+    const uint16_t held=sample.committed_buttons & kMask;
+    if (s.overflow) {
+      // Suppress the entire overflowing episode; do not re-emit held downs.
+      if (!held && !sample.committed_tap) s.overflow=false;
+      return;
+    }
+    for (unsigned i=0;i<2;++i) {
+      const uint16_t bit=Button(i);
+      if ((s.logical & bit) && !(held & bit))
+        if (!Push(s,bit,kUp)) return;
+    }
+    for (unsigned i=0;i<2;++i) {
+      const uint16_t bit=Button(i);
+      if (sample.committed_tap & bit) {
+        if (!Push(s,bit,kDown) || !Push(s,bit,kUp)) return;
+      }
+      if ((held & bit) && !(s.logical & bit)) {
+        if (!Push(s,bit,kDown)) return;
+        s.next_repeat[i]=now+kRepeatDelayMs;
+      } else if ((held & bit) && now>=s.next_repeat[i]) {
+        if (!Push(s,bit,kDown|kRepeat)) return;
+        // No catch-up flood after a pause; one repeat per observed period.
+        s.next_repeat[i]=now+kRepeatPeriodMs;
+      }
+    }
+    s.logical=held;
+  }
+
+  // Check fresh global blocked/stamp values at delivery time. Even while
+  // blocked this may return a balancing KEYUP, never a DOWN or REPEAT.
+  bool Pop(uint32_t user, Event* out, uint64_t stamp=0, bool blocked=false) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!out || user>=states_.size()) return false;
+    auto& s=states_[user];
+    if (s.stamp!=stamp || blocked || stamp) Reset(s,stamp);
+    if (s.queue.empty()) return false;
+    const auto e=s.queue.front(); s.queue.pop_front();
+    const auto bit=Mask(e.virtual_key);
+    if (e.flags & kUp) s.delivered &= ~bit;
+    else s.delivered |= bit;
+    *out=e;
+    return true;
+  }
+  bool Overflowed(uint32_t user) const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return user<states_.size() && states_[user].overflow;
+  }
+
+ private:
+  struct State {
+    std::deque<Event> queue;
+    uint16_t logical=0, delivered=0;
+    uint64_t stamp=0;
+    std::array<uint64_t,2> next_repeat{};
+    bool overflow=false;
+  };
+  static uint16_t Button(unsigned i) { return i ? kRB : kLB; }
+  static uint16_t Key(uint16_t bit) { return bit==kLB ? 0x5805 : 0x5804; }
+  static uint16_t Mask(uint16_t key) { return key==0x5805 ? kLB : kRB; }
+  static void Reset(State& s, uint64_t stamp) {
+    s.queue.clear(); s.logical=0; s.next_repeat={}; s.stamp=stamp;
+    // Never invent a release for a DOWN that was only queued, not delivered.
+    for (unsigned i=0;i<2;++i)
+      if (s.delivered & Button(i)) s.queue.push_back({Key(Button(i)),kUp});
+  }
+  static bool Push(State& s, uint16_t bit, uint16_t flags) {
+    if (s.queue.size()>=kCapacity) {
+      Reset(s,s.stamp); s.overflow=true;
+      return false;
+    }
+    s.queue.push_back({Key(bit),flags});
+    return true;
+  }
+  mutable std::mutex mutex_;
+  std::array<State,NativeRosterInputLatch::kUsers> states_{};
+};
+} // namespace rex::input
diff --git a/include/rex/input/native_roster_input_latch.h b/include/rex/input/native_roster_input_latch.h
new file mode 100644
index 0000000000000000000000000000000000000000..6e7936376a772072ff3d3db6c3c50b7eafe01d6c
--- /dev/null
+++ b/include/rex/input/native_roster_input_latch.h
@@ -0,0 +1,405 @@
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <chrono>
+#include <mutex>
+
+namespace rex::input {
+
+enum class RosterQueuePoll { Event, Empty, Disconnected, Error };
+
+// Bounded work per guest call. Hitting the cap or an error never acknowledges
+// a flush: the next call continues draining, without forwarding old events.
+template <typename Poll>
+bool DrainRosterKeyQueue(Poll poll, uint32_t limit = 64) {
+  for (uint32_t i = 0; i < limit; ++i) {
+    switch (poll()) {
+      case RosterQueuePoll::Event: break;
+      case RosterQueuePoll::Empty:
+      case RosterQueuePoll::Disconnected: return true;
+      case RosterQueuePoll::Error: return false;
+    }
+  }
+  return false;
+}
+
+// Independent of drivers, UI, and guest structures; portable tests exercise
+// the state machine. Tokens are generation-stamped, not just user indices.
+class NativeRosterInputLatch {
+ public:
+  static constexpr uint32_t kUsers = 4;
+  static_assert(std::atomic<uint64_t>::is_always_lock_free,
+                "UI control plane requires lock-free 64-bit atomics");
+  struct Sample {
+    uint16_t guest_buttons;
+    bool blocked;
+    // For a future shared GetKeystroke bridge: current committed physical
+    // buttons and an instantaneous down/up tap committed by THIS observation.
+    // guest_buttons may additionally contain a GetState-only replay pulse.
+    uint16_t committed_buttons = 0;
+    uint16_t committed_tap = 0;
+  };
+  using Milliseconds = uint64_t;
+  static constexpr Milliseconds kGraceMs = 80;
+  static Milliseconds Now() {
+    return static_cast<Milliseconds>(std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count());
+  }
+
+  // UI control plane: no guest mutex acquisition. The binding and its
+  // version publish together, so disable/re-enable cannot preserve a gesture.
+  void Configure(uint16_t modifier, uint16_t trigger) {
+    constexpr uint16_t supported = 0xF3FF;
+    const bool valid = modifier && trigger && !(modifier & trigger) &&
+                       !((modifier | trigger) & ~supported);
+    const uint32_t next = valid ? (uint32_t(modifier) << 16) | trigger : 0;
+    uint64_t old = binding_control_.load();
+    for (;;) {
+      if (uint32_t(old) == next) {
+        if (!next) CancelUnconsumed(false);
+        return;
+      }
+      const uint64_t value = ((old + (uint64_t(1) << 32)) & 0xFFFFFFFF00000000ull) | next;
+      if (binding_control_.compare_exchange_weak(old, value)) {
+        RequireDrain((generation_.fetch_add(1) + 1) * 2);
+        CancelUnconsumed(true);
+        return;
+      }
+    }
+  }
+
+  uint16_t ReservedButtons() const {
+    const uint32_t b = uint32_t(binding_control_.load());
+    return uint16_t(b >> 16) | uint16_t(b);
+  }
+
+  // The blocked bit and reset revision are one atomic snapshot. In particular,
+  // unblock cannot become visible before the invalidation that accompanies it.
+  void SetLegacyBlocked(bool blocked) {
+    uint64_t old = legacy_control_.load();
+    for (;;) {
+      if (bool(old & 1) == blocked) return;
+      const uint64_t next = ((old & ~uint64_t(1)) + 2) | uint64_t(blocked);
+      if (legacy_control_.compare_exchange_weak(old, next)) {
+        RequireDrain((generation_.fetch_add(1) + 1) * 2);
+        if (blocked) CancelUnconsumed(false);
+        return;
+      }
+    }
+  }
+  bool LegacyBlocked() const { return (legacy_control_.load() & 1) != 0; }
+
+#ifdef REX_NATIVE_ROSTER_TESTING
+  void TestAfterValidatedClaim(void (*fn)(void*), void* context) {
+    test_after_claim_ = fn; test_context_ = context;
+  }
+  void TestAfterConsumeClaim(void (*fn)(void*), void* context) {
+    test_after_consume_ = fn; test_consume_context_ = context;
+  }
+  template <typename F> void TestWithGuestMutationLock(F f) {
+    std::lock_guard<std::recursive_mutex> lock(guest_mutex_);
+    f();
+  }
+#endif
+
+  // Production calls use steady_clock; portable tests inject a monotonic time.
+  // Observe is a guest-side sample. A released pending tap is replayed for one
+  // state sample so that a tap shorter than the grace is not simply erased.
+  Sample Observe(uint32_t user, uint16_t raw, bool connected, bool legacy_blocked,
+                 Milliseconds now = Now(), bool consume_state_replay = true,
+                 bool analog_neutral = true) {
+    std::lock_guard<std::recursive_mutex> lock(guest_mutex_);
+    if (user >= kUsers) return {raw, legacy_blocked || Active()};
+    if (!connected) raw = 0;
+    const uint64_t binding_control = binding_control_.load();
+    const uint64_t reset_epoch = reset_epoch_.load();
+    const uint64_t legacy_control = legacy_control_.load();
+    legacy_blocked = legacy_blocked || bool(legacy_control & 1);
+    const bool control_changed = seen_binding_[user] != binding_control ||
+        seen_reset_[user] != reset_epoch || seen_legacy_[user] != legacy_control;
+    if (control_changed) {
+      ResetGesture(user);
+      seen_binding_[user] = binding_control;
+      seen_reset_[user] = reset_epoch;
+      seen_legacy_[user] = legacy_control;
+    }
+    const uint32_t binding = uint32_t(binding_control);
+    const uint16_t chord = uint16_t(binding >> 16) | uint16_t(binding);
+    uint64_t quarantine = quarantine_[user].load();
+    const bool was_blocked = control_changed || legacy_blocked || Active() || quarantine != 0;
+    auto& state = gestures_[user];
+    auto result = [&](uint16_t committed, uint16_t tap = 0) -> Sample {
+      // An overlapping control transition cannot return an old replay. Modal
+      // readiness is published only from a guest poll that returns suppression.
+      if (Blocked(user)) {
+        ResetGesture(user);
+        PublishReady();
+        return {0, true};
+      }
+      if (binding_control_.load() != binding_control || reset_epoch_.load() != reset_epoch ||
+          legacy_control_.load() != legacy_control) {
+        ResetGesture(user);
+        return {0, true};
+      }
+      replay_[user] |= tap;
+      uint16_t guest = uint16_t(committed | replay_[user]);
+      if (consume_state_replay) {
+        // A replayed released tap must have a visible release boundary even
+        // if a fresh physical press arrives in the very next guest poll.
+        const uint16_t release = release_next_[user];
+        guest &= ~release;
+        release_next_[user] = uint16_t(replay_[user] & ~committed & ~release);
+        replay_[user] = uint16_t((committed | replay_[user]) & release);
+      }
+      return {guest, false, committed, tap};
+    };
+    if (was_blocked) {
+      // Never preserve a pending replay across keyboard/legacy/modal entry.
+      state = {Phase::Pass, 0, 0};
+      replay_[user] = release_next_[user] = 0;
+      if ((!connected || (!raw && analog_neutral)) && quarantine) quarantine_[user].compare_exchange_strong(quarantine, 0);
+      if (!raw) state = {};
+      PublishReady();
+      return {0, true}; // the neutral quarantine-clearing poll remains blocked
+    }
+    if (!connected) {
+      state = {};
+      replay_[user] = release_next_[user] = 0;
+      return {0, false};
+    }
+    if (!chord) { state = {}; return result(raw); }
+    const uint16_t held = raw & chord;
+    if (state.phase == Phase::Pass) {
+      if (!held) state = {};
+      return result(raw);
+    }
+    if (state.phase == Phase::Idle) {
+      if (!held) return result(raw);
+      if (held == chord) {
+        if (OpenImpl(user, legacy_blocked, true, binding_control, reset_epoch, legacy_control)) {
+          ResetGesture(user);
+          PublishReady();
+          return {0, true};
+        }
+        return {0, Blocked(user)};
+      }
+      state = {Phase::Pending, held, now};
+      return result(uint16_t(raw & ~chord));
+    }
+    // Timeout wins at the exact boundary. A second bumper arriving at/after
+    // 80 ms cannot retroactively steal an ordinary singleton press.
+    const bool expired = now >= state.since && now - state.since >= kGraceMs;
+    if (!expired && held == chord) {
+      if (OpenImpl(user, legacy_blocked, true, binding_control, reset_epoch, legacy_control)) {
+          ResetGesture(user);
+          PublishReady();
+          return {0, true};
+        }
+      return {0, Blocked(user)};
+    }
+    if (expired || !(held & state.first)) {
+      const uint16_t first = state.first;
+      state = {Phase::Pass, 0, 0};
+      // Include the first button even if already released: exactly one state
+      // sample of down, followed by a real release on the next sample.
+      return result(raw, uint16_t(first & ~raw));
+    }
+    return result(uint16_t(raw & ~chord));
+  }
+
+  // Keyboard/host open is atomic and nonblocking. It acquires suppression
+  // immediately, but Consume cannot see it until a guest Observe acknowledges
+  // that barrier. UI callers must not wait synchronously for Consume to succeed.
+  bool Open(uint32_t user, bool legacy_blocked) {
+    return OpenImpl(user, legacy_blocked, false, binding_control_.load(),
+                    reset_epoch_.load(), legacy_control_.load());
+  }
+
+  // Readiness and consumption are phases in the same atomic ownership word.
+  // A separate pending store could resurrect a closed generation in a race.
+  int Consume(uint64_t* ticket) {
+    if (ticket) *ticket = 0;
+    uint64_t value = active_.load();
+    for (;;) {
+      if ((value & kPhaseMask) != kReady) return -1;
+      if (uint32_t(value >> 32) != uint32_t(binding_control_.load() >> 32) || LegacyBlocked()) {
+        CancelUnconsumed(false);
+        return -1;
+      }
+      const uint64_t base = value & ~kPhaseMask;
+      const uint64_t legacy = legacy_control_.load();
+      if (active_.compare_exchange_weak(value, base | kConsumed)) {
+#ifdef REX_NATIVE_ROSTER_TESTING
+        if (test_after_consume_) test_after_consume_(test_consume_context_);
+#endif
+        // Configure may publish between the first revision check and this CAS,
+        // then preserve Consumed. No caller has received this owner yet: reject
+        // it and close only this exact ticket before publishing the UI request.
+        if (uint32_t(base >> 32) != uint32_t(binding_control_.load() >> 32) ||
+            (legacy & 1) || legacy_control_.load() != legacy) {
+          CloseTicket(base, false);
+          return -1;
+        }
+        if (ticket) *ticket = base;
+        return int((base & 7) - 1);
+      }
+    }
+  }
+
+  // UI close never waits for guest mutation. A closing phase prevents a new
+  // open until every user's quarantine and drain stamp have been published.
+  bool Close(uint64_t ticket) {
+    if (!ticket || (ticket & kPhaseMask) || !(ticket & 7) || (ticket & 7) > kUsers)
+      return false;
+    return CloseTicket(ticket, false);
+  }
+
+  bool Active() const { return active_.load() != 0; }
+  bool Blocked(uint32_t user) const {
+    return Active() || (user < kUsers && quarantine_[user].load() != 0);
+  }
+  uint64_t DrainStamp(uint32_t user) const {
+    if (user >= kUsers) return 0;
+    const uint64_t required = drain_required_.load();
+    return drained_[user].load() < required ? required : 0;
+  }
+  bool CompleteDrain(uint32_t user, uint64_t stamp) {
+    if (user >= kUsers || !stamp || LegacyBlocked() || Blocked(user) || drain_required_.load() != stamp)
+      return false;
+    uint64_t old = drained_[user].load();
+    while (old < stamp && !drained_[user].compare_exchange_weak(old, stamp)) {}
+    // A newer required epoch cannot be cleared by acknowledging this old one.
+    return drain_required_.load() == stamp && !LegacyBlocked() && !Blocked(user);
+  }
+
+  // Classification only: callers MUST NOT discard every classified event.
+  // A committed singleton needs its down/up events delivered; only a successful
+  // chord or modal quarantine may consume the whole gesture.
+  // Constants are the documented VK_PAD values used by all SDK drivers.
+  bool ReservedKey(uint16_t key) const {
+    uint16_t mask = 0;
+    switch (key) {
+      case 0x5800: mask = 0x1000; break; // A
+      case 0x5801: mask = 0x2000; break;
+      case 0x5802: mask = 0x4000; break;
+      case 0x5803: mask = 0x8000; break;
+      case 0x5804: mask = 0x0200; break; // R shoulder
+      case 0x5805: mask = 0x0100; break;
+      case 0x5810: mask = 0x0001; break;
+      case 0x5811: mask = 0x0002; break;
+      case 0x5812: mask = 0x0004; break;
+      case 0x5813: mask = 0x0008; break;
+      case 0x5814: mask = 0x0010; break;
+      case 0x5815: mask = 0x0020; break; // Back
+      case 0x5816: mask = 0x0040; break;
+      case 0x5817: mask = 0x0080; break; // R thumb
+      default: break;
+    }
+    return (mask & ReservedButtons()) != 0;
+  }
+
+ private:
+  enum class Phase { Idle, Pending, Pass };
+  struct Gesture {
+    Phase phase = Phase::Idle;
+    uint16_t first = 0;
+    Milliseconds since = 0;
+  };
+  static constexpr uint64_t kInitializing = 8, kAwaitingPoll = 16,
+                            kReady = 32, kConsumed = 64, kClosing = 128;
+  static constexpr uint64_t kPhaseMask = 0xF8;
+  void ResetGesture(uint32_t user) {
+    gestures_[user] = {Phase::Pass, 0, 0};
+    replay_[user] = release_next_[user] = 0;
+  }
+  bool OpenImpl(uint32_t user, bool legacy_blocked, bool chord,
+                uint64_t binding, uint64_t reset, uint64_t legacy) {
+    if (user >= kUsers || legacy_blocked || (legacy & 1) || LegacyBlocked()) return false;
+    // Opaque tickets embed the binding revision plus a unique lifetime serial.
+    // Refuse rather than wrap after 16,777,215 control/open serial allocations.
+    const uint64_t serial = generation_.fetch_add(1) + 1;
+    if (serial > 0xFFFFFF) return false;
+    const uint64_t ticket = (binding & 0xFFFFFFFF00000000ull) | (serial << 8) | (user + 1);
+    uint64_t expected = 0;
+    if (!active_.compare_exchange_strong(expected, ticket | kInitializing)) return false;
+    if (binding_control_.load() != binding || legacy_control_.load() != legacy ||
+        (chord && (quarantine_[user].load() || reset_epoch_.load() != reset))) {
+      CloseTicket(ticket, true);
+      return false;
+    }
+#ifdef REX_NATIVE_ROSTER_TESTING
+    if (test_after_claim_) test_after_claim_(test_context_);
+#endif
+    RequireDrain(DrainEpoch(ticket, false));
+    expected = ticket | kInitializing;
+    return active_.compare_exchange_strong(expected, ticket | kAwaitingPoll);
+  }
+  void PublishReady() {
+    uint64_t value = active_.load();
+    if ((value & kPhaseMask) != kAwaitingPoll) return;
+    if (uint32_t(value >> 32) != uint32_t(binding_control_.load() >> 32) || LegacyBlocked()) {
+      CancelUnconsumed(false);
+      return;
+    }
+    active_.compare_exchange_strong(value, (value & ~kPhaseMask) | kReady);
+  }
+  void CancelUnconsumed(bool stale_binding_only) {
+    uint64_t value = active_.load();
+    for (;;) {
+      const uint64_t phase = value & kPhaseMask;
+      if (!value || phase == kConsumed || phase == kClosing) return;
+      if (stale_binding_only && uint32_t(value >> 32) == uint32_t(binding_control_.load() >> 32)) return;
+      const uint64_t ticket = value & ~kPhaseMask;
+      if (active_.compare_exchange_weak(value, ticket | kClosing)) {
+        FinishClose(ticket);
+        return;
+      }
+    }
+  }
+  bool CloseTicket(uint64_t ticket, bool allow_initializing) {
+    uint64_t expected = active_.load();
+    for (;;) {
+      if (!expected || (expected & ~kPhaseMask) != ticket ||
+          (!allow_initializing && (expected & kPhaseMask) == kInitializing) ||
+          (expected & kPhaseMask) == kClosing) return false;
+      if (active_.compare_exchange_weak(expected, ticket | kClosing)) break;
+    }
+    return FinishClose(ticket);
+  }
+  bool FinishClose(uint64_t ticket) {
+    const uint64_t closing = ticket | kClosing;
+    for (auto& q : quarantine_) q.store(closing);
+    RequireDrain(DrainEpoch(ticket, true));
+    reset_epoch_.fetch_add(1);
+    uint64_t expected = closing;
+    return active_.compare_exchange_strong(expected, 0);
+  }
+  static uint64_t DrainEpoch(uint64_t ticket, bool closed) {
