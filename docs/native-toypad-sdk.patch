+#include <rex/input/native_roster_bumper_keys.h>
+#include <cassert>
+#include <iostream>
+using L=rex::input::NativeRosterInputLatch;
+using K=rex::input::NativeRosterBumperKeys;
+using E=K::Event;
+L::Sample sample(uint16_t held=0,uint16_t tap=0,bool blocked=false) { return {held,blocked,held,tap}; }
+void expect(K& k,unsigned user,uint16_t key,uint16_t flags,uint64_t stamp=0,bool blocked=false) {
+  E e{}; assert(k.Pop(user,&e,stamp,blocked)); assert(e.virtual_key==key && e.flags==flags);
+}
+void empty(K& k,unsigned user=0) { E e{}; assert(!k.Pop(user,&e)); }
+int main() {
+  { K k; k.Feed(0,sample(K::kLB),0); expect(k,0,0x5805,K::kDown);
+    k.Feed(0,sample(K::kLB),399); empty(k);
+    k.Feed(0,sample(K::kLB),400); expect(k,0,0x5805,K::kDown|K::kRepeat);
+    k.Feed(0,sample(K::kLB),479); empty(k);
+    k.Feed(0,sample(K::kLB),480); expect(k,0,0x5805,K::kDown|K::kRepeat);
+    k.Feed(0,sample(),481); expect(k,0,0x5805,K::kUp); empty(k);
+  }
+  // Every sampled short tap survives even when GetState replay coalesces.
+  { K k; for(unsigned i=0;i<10;++i) k.Feed(1,sample(0,K::kRB),i);
+    for(unsigned i=0;i<10;++i) { expect(k,1,0x5804,K::kDown); expect(k,1,0x5804,K::kUp); }
+    empty(k,1); empty(k,0);
+  }
+  // Modal reset before delivery discards undelivered down/up completely.
+  { K k; k.Feed(0,sample(0,K::kLB),0); k.Feed(0,sample(0,0,true),1,17);
+    E e{}; assert(!k.Pop(0,&e,17,true)); }
+  // Modal reset after down balances ONLY that delivered down. Fresh blocked
+  // delivery checks protect events queued just before a modal opened.
+  { K k; k.Feed(0,sample(K::kLB),0); expect(k,0,0x5805,K::kDown);
+    k.Feed(0,sample(K::kLB|K::kRB),1);
+    expect(k,0,0x5805,K::kUp,42,true); E e{}; assert(!k.Pop(0,&e,42,true));
+    k.Feed(0,sample(),2,42); assert(!k.Pop(0,&e,42,true));
+    k.Feed(0,sample(),3); empty(k);
+  }
+  // Overflow drops pending unobserved keys and balances delivered keys;
+  // held input cannot spontaneously restart until neutral.
+  { K k; k.Feed(0,sample(K::kLB),0); expect(k,0,0x5805,K::kDown);
+    for(unsigned i=0;i<100;++i) k.Feed(0,sample(K::kLB, K::kRB),i);
+    assert(k.Overflowed(0)); expect(k,0,0x5805,K::kUp); empty(k);
+    k.Feed(0,sample(K::kLB),1000); empty(k); assert(k.Overflowed(0));
+    k.Feed(0,sample(),1001); assert(!k.Overflowed(0));
+    k.Feed(0,sample(K::kLB),1002); expect(k,0,0x5805,K::kDown);
+  }
+  // Both polling paths feed ONE queue; key-only polls preserve state replay.
+  { L l; K k; l.Configure(K::kLB,K::kRB);
+    auto observe=[&](uint16_t raw,uint64_t now,bool state){ auto s=l.Observe(0,raw,true,false,now,state); k.Feed(0,s,now); return s; };
+    observe(0,0,true); observe(K::kLB,1,true); empty(k);
+    observe(0,2,false); expect(k,0,0x5805,K::kDown); expect(k,0,0x5805,K::kUp);
+    assert(observe(0,3,true).guest_buttons==K::kLB); empty(k);
+    assert(observe(0,4,true).guest_buttons==0); empty(k);
+    observe(K::kLB,5,false); auto chord=observe(K::kLB|K::kRB,6,false);
+    assert(chord.blocked); empty(k);
+  }
+  std::cout << "PASS: bounded bumper key bridge, ordered taps, repeats, modal balancing and overflow\n";
+}
diff --git a/tests/native_roster_input_latch_test.cpp b/tests/native_roster_input_latch_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e809eee1b3e8af810bceb400e9aef4a001f7bf5b
--- /dev/null
+++ b/tests/native_roster_input_latch_test.cpp
@@ -0,0 +1,116 @@
+#include <rex/input/native_roster_input_latch.h>
+#include <cassert>
+#include <deque>
+#include <iostream>
+using rex::input::NativeRosterInputLatch;
+using rex::input::DrainRosterKeyQueue;
+using rex::input::RosterQueuePoll;
+constexpr uint16_t LB=0x100, RB=0x200, Back=0x20, R3=0x80, A=0x1000;
+using L = NativeRosterInputLatch;
+void arm(L& l) { l.Configure(LB,RB); for (unsigned i=0;i<4;++i) l.Observe(i,0,true,false,0); }
+int main() {
+  // Startup/rebinding while held passes through until a neutral observation.
+  { L l; l.Configure(LB,RB);
+    assert(l.Observe(0,LB|RB,true,false,0).blocked);
+    assert(l.Observe(0,LB|RB,true,false,0).guest_buttons==(LB|RB));
+    assert(!l.Active()); l.Observe(0,0,true,false,1);
+    assert(l.Observe(0,LB|RB,true,false,2).blocked);
+  }
+  for (auto first : {LB,RB}) {
+    const uint16_t second = (LB|RB)^first;
+    L l; arm(l);
+    assert(l.Observe(0, first|A,true,false,10).guest_buttons == A);
+    assert(l.Observe(0, first,true,false,89).guest_buttons == 0);
+    assert(l.Observe(0, first,true,false,90).guest_buttons == first);
+    assert(l.Observe(0, first|second,true,false,91).guest_buttons == (LB|RB));
+    assert(!l.Active()); // second arrival after expiry never steals first
+    assert(l.Observe(0, second,true,false,92).guest_buttons == second);
+    assert(l.Observe(0, first|second,true,false,93).guest_buttons == (LB|RB));
+    assert(!l.Active()); // re-press while other held cannot rearm
+    l.Observe(0,0,true,false,94);
+    assert(l.Observe(0,first|second,true,false,95).blocked);
+    uint64_t token=0; assert(l.Consume(&token)==0 && token);
+    assert(l.Close(token));
+  }
+  for (auto arrival : {79u,80u,81u}) {
+    L l; arm(l); l.Observe(0,LB,true,false,100);
+    auto s=l.Observe(0,LB|RB,true,false,100+arrival);
+    assert(l.Active()==(arrival<80));
+    assert(s.blocked==(arrival<80));
+    if (arrival>=80) assert(s.guest_buttons==(LB|RB));
+  }
+  // Early released taps replay down in one state call, then up. A key-only
+  // observation may advance arbitration but cannot consume that state pulse.
+  for (auto first : {LB,RB}) {
+    L l; arm(l); l.Observe(0,first,true,false,100,false);
+    auto tap=l.Observe(0,0,true,false,110,false);
+    assert(tap.committed_tap==first && tap.committed_buttons==0);
+    assert(l.Observe(0,0,true,false,111,false).committed_tap==0);
+    assert(l.Observe(0,0,true,false,112).guest_buttons==first);
+    assert(l.Observe(0,0,true,false,113).guest_buttons==0);
+  }
+  // Release first and press second in one snapshot cannot count as a chord.
+  { L l; arm(l); l.Observe(0,LB,true,false,0);
+    auto s=l.Observe(0,RB,true,false,1);
+    assert(s.guest_buttons==(LB|RB) && s.committed_tap==LB);
+    assert(!l.Active()); assert(l.Observe(0,RB,true,false,2).guest_buttons==RB);
+  }
+  // Fast double tap: force the release edge between synthetic tap and fresh press.
+  { L l; arm(l); assert(l.Observe(0,LB,true,false,0).guest_buttons==0);
+    assert(l.Observe(0,0,true,false,10).guest_buttons==LB);
+    assert(l.Observe(0,LB,true,false,20).guest_buttons==0);
+    assert(l.Observe(0,0,true,false,30).guest_buttons==LB);
+    assert(l.Observe(0,0,true,false,40).guest_buttons==0);
+  }
+  // Disconnected pending input is discarded; no phantom tap on reconnect.
+  { L l; arm(l); l.Observe(0,LB,true,false,1);
+    assert(!l.Observe(0,0,false,false,2).guest_buttons);
+    assert(!l.Observe(0,0,true,false,3).guest_buttons);
+  }
+  // Per-user independence and old Back/R3 passthrough.
+  { L l; arm(l);
+    assert(!l.ReservedKey(0x5815) && !l.ReservedKey(0x5817));
+    assert(l.ReservedKey(0x5804) && l.ReservedKey(0x5805));
+    assert(l.Observe(2,Back|R3,true,false,1).guest_buttons==(Back|R3));
+    l.Observe(0,LB,true,false,2); l.Observe(1,RB,true,false,2);
+    assert(!l.Active()); assert(l.Observe(0,LB,true,false,82).guest_buttons==LB);
+    assert(l.Observe(1,RB,true,false,82).guest_buttons==RB);
+  }
+  // Modal generations, queue epochs, all-user quarantine and analog neutrality.
+  { L l; arm(l); l.Observe(2,LB,true,false,1);
+    assert(l.Open(0,false)); l.Observe(0,0,true,false,1); uint64_t t=0; assert(l.Consume(&t)==0);
+    auto open=l.DrainStamp(1); assert(!l.CompleteDrain(1,open));
+    assert(l.Close(t)); assert(!l.Active());
+    assert(l.Observe(1,0,true,false,2,true,false).blocked);
+    assert(l.Blocked(1)); // buttons released, stick still held
+    assert(l.Observe(1,0,true,false,3,true,true).blocked);
+    assert(!l.Blocked(1)); assert(!l.CompleteDrain(1,open));
+    auto closed=l.DrainStamp(1); assert(closed!=open && l.CompleteDrain(1,closed));
+    assert(!l.Observe(1,A,true,false,4).blocked);
+    assert(l.Observe(2,LB,true,false,5).blocked);
+    assert(l.Observe(2,0,false,false,6,true,false).blocked);
+    assert(!l.Observe(2,0,true,false,7).guest_buttons); // pending singleton purged
+    assert(l.Open(2,false)); l.Observe(2,0,true,false,8); uint64_t t2=0; assert(l.Consume(&t2)==2);
+    assert(t2!=t && !l.Close(t) && l.Active());
+    l.Configure(0,0); assert(l.Active()); assert(l.Close(t2));
+  }
+  // Legacy overlay cancels a pending replay and forbids open.
+  { L l; arm(l); l.Observe(0,LB,true,false,1);
+    assert(l.Observe(0,LB|RB,true,true,2).blocked);
+    assert(!l.Active() && !l.Open(0,true));
+    assert(l.Observe(0,LB|RB,true,false,3).guest_buttons==(LB|RB));
+    assert(!l.Active()); l.Observe(0,0,true,false,4);
+    assert(l.Observe(0,LB|RB,true,false,5).blocked);
+  }
+  // Bounded drain does not acknowledge cap or driver errors as empty.
+  std::deque<int> q(130,1); auto poll=[&] {
+    if(q.empty()) return RosterQueuePoll::Empty;
+    q.pop_front(); return RosterQueuePoll::Event;
+  };
+  assert(!DrainRosterKeyQueue(poll) && q.size()==66);
+  assert(!DrainRosterKeyQueue(poll) && q.size()==2);
+  assert(DrainRosterKeyQueue(poll));
+  assert(!DrainRosterKeyQueue([]{return RosterQueuePoll::Error;}));
+  assert(DrainRosterKeyQueue([]{return RosterQueuePoll::Disconnected;}));
+  std::cout << "PASS: deterministic 80ms bumper arbitration, replay, generations, analog quarantine\n";
+}
diff --git a/tests/native_roster_nonblocking_test.cpp b/tests/native_roster_nonblocking_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..675cb2a68ff643bc619beb58cfaf04ac41e49333
--- /dev/null
+++ b/tests/native_roster_nonblocking_test.cpp
@@ -0,0 +1,83 @@
+#define REX_NATIVE_ROSTER_TESTING
+#include <rex/input/native_roster_input_latch.h>
+#include <cassert>
+#include <future>
+#include <chrono>
+#include <atomic>
+#include <thread>
+#include <iostream>
+using L=rex::input::NativeRosterInputLatch;
+constexpr uint16_t LB=0x100,RB=0x200;
+void arm(L& l) { l.Configure(LB,RB); for(unsigned i=0;i<4;++i) l.Observe(i,0,true,false,0); }
+void acknowledge(L& l) { assert(l.Observe(0,0,true,false,1).blocked); }
+uint64_t consume(L& l) { uint64_t t=0;assert(l.Consume(&t)==0);assert(t);return t; }
+int main(){
+  // UI controls finish while a simulated guest mutation owner is suspended.
+  {L l;arm(l);std::promise<void> held,release;auto wait=release.get_future().share();
+   std::thread guest([&]{l.TestWithGuestMutationLock([&]{held.set_value();wait.wait();});});held.get_future().wait();
+   auto ui=std::async(std::launch::async,[&]{
+     l.Configure(RB,LB);l.SetLegacyBlocked(true);l.SetLegacyBlocked(false);
+     assert(l.Open(0,false));assert(l.Consume(nullptr)==-1);
+     l.Configure(0,0);assert(!l.Active());return true;
+   });
+   assert(ui.wait_for(std::chrono::seconds(1))==std::future_status::ready);assert(ui.get());
+   release.set_value();guest.join();
+  }
+  // Close of consumed ownership is equally nonblocking; stale tickets fail.
+  {L l;arm(l);assert(l.Open(0,false));acknowledge(l);auto t=consume(l);
+   std::promise<void> held,release;auto wait=release.get_future().share();
+   std::thread guest([&]{l.TestWithGuestMutationLock([&]{held.set_value();wait.wait();});});held.get_future().wait();
+   auto ui=std::async(std::launch::async,[&]{assert(l.Close(t));assert(!l.Close(t));return true;});
+   assert(ui.wait_for(std::chrono::seconds(1))==std::future_status::ready);assert(ui.get());release.set_value();guest.join();
+   assert(!l.Active() && l.Blocked(0));
+  }
+  // Keyboard request is not visible until suppression is observed.
+  {L l;arm(l);assert(l.Open(0,false));assert(l.Consume(nullptr)==-1);
+   acknowledge(l);auto t=consume(l);assert(l.Consume(nullptr)==-1);
+   l.Configure(0,0);assert(l.Active()); // consumed ownership survives disable
+   assert(l.Close(t));
+   auto close=l.DrainStamp(0);assert(close);assert(!l.CompleteDrain(0,close));
+   assert(l.Observe(0,0,true,false,2,true,false).blocked);assert(l.Blocked(0));
+   assert(l.Observe(0,0,true,false,3,true,true).blocked);assert(!l.Blocked(0));
+   assert(l.CompleteDrain(0,close));assert(!l.DrainStamp(0));
+  }
+  // Configure cancels both awaiting and ready (unconsumed), never old close/new owner.
+  {L l;arm(l);assert(l.Open(0,false));l.Configure(0,0);assert(!l.Active());assert(l.Consume(nullptr)==-1);
+   arm(l);assert(l.Open(0,false));acknowledge(l);l.Configure(0,0);assert(!l.Active());assert(l.Consume(nullptr)==-1);
+   arm(l);assert(l.Open(0,false));acknowledge(l);auto old=consume(l);assert(l.Close(old));
+   l.Observe(0,0,true,false,5);assert(l.Open(0,false));acknowledge(l);auto newer=consume(l);assert(newer!=old);
+   assert(!l.Close(old)&&l.Active());assert(l.Close(newer));
+  }
+  // Unobserved legacy true/false cancels old replay and creates real drain work.
+  {L l;arm(l);l.Observe(0,LB,true,false,1);l.Observe(0,0,true,false,2,false);
+   const auto before=l.DrainStamp(0);l.SetLegacyBlocked(true);l.SetLegacyBlocked(false);
+   auto reset=l.Observe(0,0,true,false,3);assert(reset.blocked&&reset.guest_buttons==0);
+   assert(l.DrainStamp(0)>before);assert(!l.CompleteDrain(0,before));
+   assert(l.Observe(0,0,true,false,4).guest_buttons==0);
+  }
+  // Binding change also cancels a pending singleton instead of replaying it.
+  {L l;arm(l);l.Observe(0,LB,true,false,1);l.Configure(0,0);l.Configure(LB,RB);
+   assert(l.Observe(0,0,true,false,2).blocked);assert(l.Observe(0,0,true,false,3).guest_buttons==0);
+  }
+  // Interrupted initializer resumes after cancel + newer ready request: its
+  // old drain publication cannot replace newer stamp or resurrect old pending.
+  {L l;arm(l);struct Pause {std::promise<void> held,release;std::shared_future<void> wait;std::atomic<int> n{0};} p;
+   p.wait=p.release.get_future().share();l.TestAfterValidatedClaim([](void* v){auto& p=*static_cast<Pause*>(v);if(p.n.fetch_add(1)==0){p.held.set_value();p.wait.wait();}},&p);
+   auto old=std::async(std::launch::async,[&]{return l.Open(0,false);});p.held.get_future().wait();
+   l.Configure(0,0);assert(!l.Active());l.Configure(LB,RB);
+   assert(l.Open(0,false));acknowledge(l);auto newer=consume(l);auto stamp=l.DrainStamp(0);
+   p.release.set_value();assert(!old.get());assert(l.Active());assert(l.DrainStamp(0)==stamp);assert(l.Consume(nullptr)==-1);assert(l.Close(newer));
+  }
+  // Disable between Consume CAS and UI publication must reject the old owner,
+  // even though Configure sees Consumed and intentionally preserves ownership.
+  {L l;arm(l);assert(l.Open(0,false));acknowledge(l);
+   struct Pause {std::promise<void> held,release;std::shared_future<void> wait;} p;
+   p.wait=p.release.get_future().share();l.TestAfterConsumeClaim([](void* v){auto& p=*static_cast<Pause*>(v);p.held.set_value();p.wait.wait();},&p);
+   auto taking=std::async(std::launch::async,[&]{uint64_t t=99;const int user=l.Consume(&t);assert(t==0);return user;});
+   p.held.get_future().wait();l.Configure(0,0);assert(l.Active());
+   p.release.set_value();assert(taking.get()==-1);assert(!l.Active());
+  }
+  // Chord publication stays immediate within its suppressing guest sample.
+  {L l;arm(l);l.Observe(0,LB,true,false,10);assert(l.Observe(0,LB|RB,true,false,89).blocked);auto t=consume(l);assert(l.Close(t));}
+  std::cout<<"PASS: nonblocking UI control plane, suppression barrier, epochs and stale publication\n";
+}
