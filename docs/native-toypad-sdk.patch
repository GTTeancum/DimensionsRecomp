diff --git a/include/rex/input/portal/toypad_led_animation.h b/include/rex/input/portal/toypad_led_animation.h
new file mode 100644
index 0000000000000000000000000000000000000000..229a8f835ba9fc92f44b2ff68da123c14e235fe9
--- /dev/null
+++ b/include/rex/input/portal/toypad_led_animation.h
@@ -0,0 +1,50 @@
+#pragma once
+#include <array>
+#include <cmath>
+#include <cstdint>
+
+namespace rex::input {
+// Native presentation clock, independent of overlay lifetime and GET_LED's
+// eight-bit wire serial. Timing follows the companion's 40 ms calibration.
+struct ToypadLightAnimation {
+  uint8_t mode = 0;
+  uint8_t r = 0, g = 0, b = 0;
+  uint8_t from_r = 0, from_g = 0, from_b = 0;
+  uint8_t on_ticks = 0, off_ticks = 0, count = 0, speed_ticks = 0;
+  std::array<uint8_t, 3> base{};
+  uint64_t started_ms = 0, revision = 0;
+};
+using ToypadRgb = std::array<uint8_t, 3>;
+inline ToypadRgb EvaluateToypadLight(const ToypadLightAnimation& light, uint64_t now_ms) {
+  const ToypadRgb target{light.r, light.g, light.b};
+  const ToypadRgb source{light.from_r, light.from_g, light.from_b};
+  if (light.mode == 0) return {};
+  if (light.mode == 1) return target;
+  const uint64_t elapsed = now_ms >= light.started_ms ? now_ms - light.started_ms : 0;
+  if (light.mode == 2) {
+    const uint64_t on = uint64_t(light.on_ticks ? light.on_ticks : 1) * 40;
+    const uint64_t off = uint64_t(light.off_ticks ? light.off_ticks : 1) * 40;
+    const uint64_t period = on + off;
+    // Hardware-facing clients define count as transitions, not whole cycles.
+    // Odd counts end on the prior displayed colour; even on the target.
+    if (light.count && light.count != 255) {
+      const uint64_t end = uint64_t(light.count / 2) * period + (light.count % 2 ? on : 0);
+      if (elapsed >= end) return light.count % 2 ? source : target;
+    }
+    return elapsed % period < on ? target : source;
+  }
+  const uint64_t step = uint64_t(light.speed_ticks ? light.speed_ticks : 25) * 40;
+  uint64_t leg = elapsed / step;
+  if (light.count && leg >= light.count) return light.count % 2 ? target : source;
+  const double fraction = double(elapsed % step) / double(step);
+  // Companion-style smooth cross-fade; no bitmap-cache quantisation needed.
+  const double blend = .5 - .5 * std::cos(fraction * 3.14159265358979323846);
+  ToypadRgb result{};
+  for (size_t i = 0; i < 3; ++i) {
+    const double a = leg % 2 ? target[i] : source[i];
+    const double b = leg % 2 ? source[i] : target[i];
+    result[i] = static_cast<uint8_t>(a + (b - a) * blend + .5);
+  }
+  return result;
+}
+} // namespace rex::input
