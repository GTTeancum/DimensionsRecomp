+#include <rex/ui/graphics_upload_buffer_pool.h>
+#include <cassert>
+#include <set>
+#include <vector>
+#include <tuple>
+#include <cstdio>
+struct Pool : rex::ui::GraphicsUploadBufferPool {
+  Pool():GraphicsUploadBufferPool(64){}
+  struct Tracked : Page { static inline int live=0; Tracked(){++live;} ~Tracked(){--live;} };
+  bool fail=false; int created=0;
+  std::vector<std::tuple<Page*,size_t,size_t>> flushes;
+  Page* req(size_t n,size_t& o,size_t a=1,uint64_t s=1){return Request(s,n,a,o);}
+  Page* part(size_t n,size_t& o,size_t& got,size_t a=1){return RequestPartial(1,n,a,o,got);}
+  Page* CreatePageImplementation()override {if(fail)return nullptr; ++created; return new Tracked;}
+  void FlushPageWrites(Page*p,size_t o,size_t n)override {assert(p);assert(o+n<=64);flushes.emplace_back(p,o,n);}
+  void valid(){std::set<Page*> all;Page*last=nullptr;for(auto*p=writable_first_;p;p=p->next_){assert(all.insert(p).second);last=p;}assert(last==writable_last_);last=nullptr;for(auto*p=submitted_first_;p;p=p->next_){assert(all.insert(p).second);last=p;}assert(last==submitted_last_);assert((int)all.size()==Tracked::live);assert(current_page_flushed_<=current_page_used_);assert(current_page_used_<=64);assert(writable_first_||!current_page_used_);}
+};
+int main(){size_t o,n;
+ {Pool p;p.ChangeSubmissionTimeline();p.ChangeSubmissionTimeline();p.Reclaim(99);p.valid();}
+ {Pool p;auto*a=p.req(48,o);p.FlushWrites();assert(p.flushes.size()==1);p.fail=true;assert(!p.req(32,o));p.FlushWrites();assert(p.flushes.size()==1);p.valid();p.ChangeSubmissionTimeline();p.valid();assert(p.req(32,o)==a&&o==0);p.FlushWrites();assert(p.flushes.size()==2);p.valid();}
+ {Pool p;auto*a=p.req(48,o);auto*b=p.req(32,o);assert(a!=b);p.ChangeSubmissionTimeline();p.valid();p.ChangeSubmissionTimeline();p.valid();assert(p.req(32,o)==b&&o==32);assert(p.req(64,o)==a&&o==0);p.valid();p.Reclaim(1);p.valid();p.ClearCache();p.valid();}
+ {Pool p;auto*a=p.req(64,o);p.fail=true;assert(!p.part(32,o,n,16));p.Reclaim(1);assert(p.part(32,o,n,16)==a&&o==0&&n==32);p.valid();}
+ {Pool p;auto*a=p.req(33,o);p.fail=true;assert(!p.req(32,o,16));p.Reclaim(0);p.valid();assert(!p.req(32,o,16));p.Reclaim(1);assert(p.req(32,o,16)==a&&o==0);p.valid();}
+ assert(Pool::Tracked::live==0);puts("edge tests PASS");}
