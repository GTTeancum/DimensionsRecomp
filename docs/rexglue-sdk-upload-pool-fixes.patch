@@ -0,0 +1,26 @@
+#!/usr/bin/env python3
+"""Standalone tests of the production generic pool and D3D ownership body."""
+import argparse
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+parser = argparse.ArgumentParser()
+parser.add_argument('--sanitize', action='store_true', help='enable ASan and UBSan (compiler support required)')
+args = parser.parse_args()
+here = Path(__file__).resolve().parent
+root = here.parents[2]
+cases = ['initial_failure', 'rollover_failure', 'reclaim_after_failure', 'timeline_writable_only', 'normal']
+with tempfile.TemporaryDirectory() as tmp:
+    for name in ['upload_pool_test', 'edge_tests']:
+        exe = Path(tmp) / name
+        command = [os.environ.get('CXX', 'c++'), '-std=c++23', '-Wall', '-Wextra', '-I', str(root / 'include')]
+        if args.sanitize:
+            command += ['-g', '-fsanitize=address,undefined', '-fno-omit-frame-pointer']
+        command += [str(here / (name + '.cpp')), str(root / 'src/ui/graphics_upload_buffer_pool.cpp'), '-o', str(exe)]
+        subprocess.run(command, check=True)
+        for case in cases if name == 'upload_pool_test' else [None]:
+            subprocess.run([str(exe)] + ([case] if case else []), check=True)
+subprocess.run([sys.executable, str(here / 'check_d3d_ownership.py')], check=True)
diff --git a/tests/regression/upload_buffer_pool/upload_pool_test.cpp b/tests/regression/upload_buffer_pool/upload_pool_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/regression/upload_buffer_pool/upload_pool_test.cpp
@@ -0,0 +1,40 @@
+#include <rex/ui/graphics_upload_buffer_pool.h>
+#include <cstdlib>
+#include <iostream>
+#include <string>
+#define CHECK(x) do { if (!(x)) { std::cerr << "CHECK failed: " #x << '\n'; std::exit(1); } } while (0)
+class Pool : public rex::ui::GraphicsUploadBufferPool {
+ public:
+  Pool() : GraphicsUploadBufferPool(64) {}
+  bool fail = false;
+  int created = 0, flushed = 0;
+  Page* request(size_t size, size_t& offset) { return Request(1, size, 1, offset); }
+  void check_empty_cursor() { CHECK(current_page_used_ == 0); CHECK(current_page_flushed_ == 0); }
+  void check_tail() { CHECK(writable_first_); CHECK(writable_last_); }
+ protected:
+  Page* CreatePageImplementation() override { if (fail) return nullptr; ++created; return new Page; }
+  void FlushPageWrites(Page* page, size_t, size_t) override { CHECK(page); ++flushed; }
+};
+int main(int argc, char** argv) {
+  CHECK(argc == 2); std::string test = argv[1]; Pool p; size_t offset = 999;
+  if (test == "initial_failure") {
+    p.fail = true; CHECK(!p.request(16, offset)); p.check_empty_cursor(); p.FlushWrites();
+    p.fail = false; CHECK(p.request(16, offset)); CHECK(offset == 0);
+  } else if (test == "rollover_failure") {
+    CHECK(p.request(48, offset)); p.fail = true; CHECK(!p.request(32, offset));
+    p.check_empty_cursor(); p.FlushWrites(); CHECK(!p.request(32, offset));
+    p.fail = false; CHECK(p.request(32, offset)); CHECK(offset == 0); CHECK(p.created == 2);
+  } else if (test == "reclaim_after_failure") {
+    auto* original = p.request(48, offset); CHECK(original); p.fail = true; CHECK(!p.request(32, offset));
+    p.Reclaim(1); CHECK(p.request(32, offset) == original); CHECK(offset == 0); CHECK(p.created == 1);
+  } else if (test == "timeline_writable_only") {
+    CHECK(p.request(16, offset)); p.ChangeSubmissionTimeline(); p.check_tail();
+    CHECK(p.request(16, offset)); CHECK(offset == 16);
+  } else if (test == "normal") {
+    auto* first = p.request(32, offset); CHECK(first); CHECK(offset == 0);
+    CHECK(p.request(32, offset) == first); CHECK(offset == 32);
+    CHECK(p.request(32, offset) != first); CHECK(offset == 0);
+    p.Reclaim(1); p.ChangeSubmissionTimeline(); p.check_tail();
+  } else { CHECK(false); }
+  std::cout << test << " PASS\n";
+}
