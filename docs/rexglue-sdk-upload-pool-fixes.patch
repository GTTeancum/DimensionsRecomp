+#!/usr/bin/env python3
+"""Compile the production page-creation body against a deterministic COM test double.
+
+This checks ownership, not Windows/D3D behavior. No GPU or game assets required.
+"""
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+root = Path(__file__).resolve().parents[3]
+source_path = Path(sys.argv[1]) if len(sys.argv) > 1 else root / 'src/ui/d3d12/d3d12_upload_buffer_pool.cpp'
+source = source_path.read_text()
+start = source.index('GraphicsUploadBufferPool::Page* D3D12UploadBufferPool::CreatePageImplementation() {')
+end = source.index('\nD3D12UploadBufferPool::D3D12Page::D3D12Page', start)
+body = source[start:end]
+prefix = r'''
+#include <cstddef>
+#include <cstdlib>
+#include <iostream>
+#define CHECK(x) do { if (!(x)) { std::cerr << "CHECK failed: " #x << '\n'; std::exit(1); } } while (0)
+using HRESULT = int;
+#define FAILED(x) ((x) < 0)
+#define REXLOG_ERROR(...) ((void)0)
+#define IID_PPV_ARGS(x) (x)
+constexpr int D3D12_RESOURCE_FLAG_NONE = 0, D3D12_RESOURCE_STATE_GENERIC_READ = 0;
+struct D3D12_RESOURCE_DESC {};
+struct D3D12_RANGE { size_t Begin, End; };
+struct ID3D12Resource {
+  int refs = 0, releases = 0;
+  bool map_fails = false;
+  void AddRef() { ++refs; }
+  void Release() { ++releases; --refs; }
+  HRESULT Map(int, D3D12_RANGE*, void** out) { if (map_fails) return -1; *out = this; return 0; }
+};
+namespace Microsoft::WRL {
+template<class T> class ComPtr {
+  T* ptr = nullptr;
+ public:
+  ComPtr() = default;
+  ComPtr(const ComPtr&) = delete;
+  ~ComPtr() { if (ptr) ptr->Release(); }
+  T* operator->() { return ptr; }
+  T** operator&() { return &ptr; }
+  T* Get() { return ptr; }
+};
+}
+namespace util {
+int kHeapPropertiesUpload;
+void FillBufferResourceDesc(D3D12_RESOURCE_DESC&, size_t, int) {}
+}
+struct Device {
+  ID3D12Resource resource;
+  bool create_fails = false;
+  HRESULT CreateCommittedResource(int*, int, D3D12_RESOURCE_DESC*, int, void*, ID3D12Resource** out) {
+    if (create_fails) return -1;
+    resource.refs = 1; *out = &resource; return 0;
+  }
+};
+struct Provider {
+  Device device;
+  Device* GetDevice() { return &device; }
+  int GetHeapFlagCreateNotZeroed() { return 0; }
+};
+struct GraphicsUploadBufferPool { struct Page { virtual ~Page() = default; }; };
+struct D3D12UploadBufferPool {
+  Provider provider_;
+  size_t page_size_ = 64;
+  struct D3D12Page : GraphicsUploadBufferPool::Page {
+    ID3D12Resource* buffer;
+    D3D12Page(ID3D12Resource* b, void*) : buffer(b) { buffer->AddRef(); }
+    ~D3D12Page() override { buffer->Release(); }
+  };
+  GraphicsUploadBufferPool::Page* CreatePageImplementation();
+};
+'''
+suffix = r'''
+int main() {
+  { D3D12UploadBufferPool p; p.provider_.device.create_fails = true;
+    CHECK(!p.CreatePageImplementation()); CHECK(p.provider_.device.resource.releases == 0); }
+  { D3D12UploadBufferPool p; auto& r = p.provider_.device.resource; r.map_fails = true;
+    CHECK(!p.CreatePageImplementation()); CHECK(r.releases == 1); CHECK(r.refs == 0); }
+  { D3D12UploadBufferPool p; auto& r = p.provider_.device.resource;
+    auto* page = p.CreatePageImplementation(); CHECK(page); CHECK(r.refs == 1);
+    delete page; CHECK(r.refs == 0); CHECK(r.releases == 2); }
+  std::cout << "D3D ownership: create failure, map failure, success PASS\n";
+}
+'''
+with tempfile.TemporaryDirectory() as tmp:
+    cpp = Path(tmp) / 'ownership.cpp'
+    exe = Path(tmp) / 'ownership'
+    cpp.write_text(prefix + body + suffix)
+    subprocess.run([os.environ.get('CXX', 'c++'), '-std=c++20', '-Wall', '-Wextra', '-Werror', str(cpp), '-o', str(exe)], check=True)
+    subprocess.run([str(exe)], check=True)
